 "cartoon": [
  {
   "template": "title-card",
   "props": {
    "title": "Make or Do?",
    "subtitle": "The mistake almost everyone makes",
    "kicker": "English Quick Fix",
    "characters": [
     "maya",
     "leo",
     "priya"
    ],
    "color": "#FFD9A8"
   },
   "say": "Make or do? Most learners mix them up. Here is the easy rule."
  },
  {
   "template": "dialogue",
   "props": {
    "characters": [
     "leo",
     "priya"
    ],
    "location": "office",
    "lines": [
     {
      "speaker": 0,
      "text": "I need to make my homework.",
      "expression": "worried",
      "mark": "sweat"
     },
     {
      "speaker": 1,
      "text": "Almost! You DO homework.",
      "expression": "skeptical",
      "pose": "explain"
     },
     {
      "speaker": 0,
      "text": "Then why do I MAKE a cake?",
      "expression": "surprised",
      "pose": "think",
      "mark": "question"
     },
     {
      "speaker": 1,
      "text": "Because you create something new!",
      "expression": "happy",
      "pose": "point-up",
      "mark": "sparkle"
     }
    ]
   },
   "say": "I need to make my homework. Almost! You do homework. Then why do I make a cake? Because you create something new!"
  },
  {
   "template": "explain-with-board",
   "props": {
    "character": "priya",
    "location": "classroom",
    "title": "The rule",
    "mode": "list",
    "items": [
     "*Make* = create something",
     "*Do* = tasks and jobs",
     "make a cake, do the dishes"
    ],
    "expression": "happy"
   },
   "say": "Make is for creating something. Do is for tasks and jobs. So you make a cake, and then, sadly, you do the dishes."
  }
