[
  {
    "id": "splash-title",
    "name": "Splash cover",
    "description": "Comic-book cover: full-bleed action backdrop, a hero pose, a giant 3D logo that slams in letter by letter with an impact shake, issue box and a subtitle caption. Use for the video intro or a big section opener.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Cover title, 1–4 words (big 3D lettering)."
        },
        "subtitle": {
          "type": "string",
          "description": "Tagline caption, ≤ 14 words."
        },
        "issue": {
          "type": "string",
          "description": "Issue badge text, e.g. 'No. 1', 'Part 2'."
        },
        "keyword": {
          "type": "string",
          "description": "Narration word on which the logo slams in (usually the first title word)."
        },
        "character": {
          "type": "string",
          "enum": [
            "nova",
            "sam",
            "vex",
            "pip",
            "bolt",
            "ace",
            "none"
          ],
          "description": "Recurring cast member: nova (scientist), sam (everyday narrator), vex (villain), pip (kid sidekick), bolt (robot), ace (caped hero), none."
        },
        "pose": {
          "type": "string",
          "enum": [
            "stand",
            "point",
            "explain",
            "present",
            "wave",
            "think",
            "cheer",
            "shock",
            "fist",
            "hips",
            "shrug",
            "crossed",
            "run",
            "fight"
          ],
          "description": "Cover pose (hips = heroic)."
        },
        "expression": {
          "type": "string",
          "enum": [
            "neutral",
            "happy",
            "grin",
            "shock",
            "angry",
            "sad",
            "smirk",
            "think",
            "determined",
            "scared"
          ],
          "description": "Face."
        },
        "background": {
          "type": "string",
          "enum": [
            "city",
            "street",
            "lab",
            "space",
            "interior",
            "action",
            "explosion",
            "halftone",
            "focus",
            "speed",
            "sky",
            "plain"
          ],
          "description": "Backdrop (action = sunburst rays)."
        },
        "mood": {
          "type": "string",
          "enum": [
            "day",
            "dusk",
            "night"
          ],
          "description": "Lighting for city/street/sky."
        },
        "palette": {
          "type": "string",
          "enum": [
            "red",
            "blue",
            "yellow",
            "purple",
            "green",
            "pink"
          ],
          "description": "Colour of the rays and logo."
        },
        "sfx": {
          "type": "string",
          "description": "Optional SFX word that pops after the title, e.g. 'KRAKOOM!'."
        },
        "print": {
          "type": "string",
          "enum": [
            "clean",
            "aged",
            "misprint"
          ],
          "description": "Print finish. Keep the SAME value for every scene of a video. clean = crisp newsprint, aged = yellowed vintage paper, misprint = off-register cyan ghosting."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "title": "The Battery Wars",
      "subtitle": "How a tiny cell changed the whole world",
      "issue": "No. 1",
      "keyword": "battery",
      "character": "ace",
      "pose": "hips",
      "expression": "grin",
      "background": "action",
      "palette": "red",
      "sfx": "ZAP!"
    },
    "exampleNarration": "This is the story of the battery wars — how a tiny cell changed the whole world."
  },
  {
    "id": "panel-sequence",
    "name": "Panel sequence",
    "description": "2–6 panels told in reading order: each panel gets a backdrop, an optional cast member, a caption box, an optional speech line and SFX. The camera glides panel to panel like a motion comic, then pulls back to the full page. The workhorse template for step-by-step stories and processes.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caption": {
                "type": "string",
                "description": "Narration caption, ≤ 16 words."
              },
              "keyword": {
                "type": "string",
                "description": "Narration word that reveals this panel."
              },
