          "description": "2–6 panels in narration order."
        },
        "layout": {
          "type": "string",
          "enum": [
            "grid",
            "feature",
            "strip"
          ],
          "description": "grid = balanced, feature = first panel big, strip = one row (one column in portrait)."
        },
        "camera": {
          "type": "string",
          "enum": [
            "follow",
            "page"
          ],
          "description": "follow = camera glides between panels (default); page = whole page stays in view."
        },
