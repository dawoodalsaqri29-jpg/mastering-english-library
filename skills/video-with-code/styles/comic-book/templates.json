                  "cheer",
                  "shock",
                  "fist",
                  "hips",
                  "shrug",
                  "crossed",
                  "run",
                  "fight"
                ],
                "description": "Pose."
              },
              "expression": {
                "type": "string",
                "enum": [
                  "neutral",
                  "happy",
                  "grin",
                  "shock",
                  "angry",
                  "sad",
                  "smirk",
                  "think",
                  "determined",
                  "scared"
                ],
                "description": "Face."
              },
              "line": {
                "type": "string",
                "description": "Optional words the character says (speech balloon), ≤ 14 words — copy from narration if it is dialogue."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "speech",
                  "thought",
                  "shout",
                  "whisper",
                  "radio"
                ],
                "description": "Balloon type."
              },
              "sfx": {
                "type": "string",
                "description": "Optional SFX, 1 word, e.g. 'WHOOSH!'."
              },
              "sfxColor": {
                "type": "string",
                "enum": [
                  "fire",
                  "pow",
                  "zap",
                  "ice",
                  "slime",
                  "pink",
                  "red",
                  "gold"
                ],
                "description": "SFX colours."
              },
              "effect": {
                "type": "string",
                "enum": [
                  "none",
                  "focus",
                  "speed"
                ],
                "description": "Overlay: radial focus lines or moving speed lines."
              }
            },
            "required": [
              "caption"
            ],
            "additionalProperties": false
