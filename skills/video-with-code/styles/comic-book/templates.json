                  "day",
                  "dusk",
                  "night"
                ],
                "description": "Lighting."
              },
              "character": {
                "type": "string",
                "enum": [
                  "nova",
                  "sam",
                  "vex",
                  "pip",
                  "bolt",
                  "ace",
                  "none"
                ],
                "description": "Recurring cast member: nova (scientist), sam (everyday narrator), vex (villain), pip (kid sidekick), bolt (robot), ace (caped hero), none."
              },
              "shot": {
                "type": "string",
                "enum": [
                  "full",
                  "mid",
                  "close",
                  "silhouette"
                ],
                "description": "Framing."
              },
              "pose": {
                "type": "string",
                "enum": [
                  "stand",
                  "point",
                  "explain",
                  "present",
                  "wave",
