          "enum": [
            "clean",
            "aged",
            "misprint"
          ],
          "description": "Print finish. Keep the SAME value for every scene of a video. clean = crisp newsprint, aged = yellowed vintage paper, misprint = off-register cyan ghosting."
        }
      },
      "required": [
        "panels"
      ],
      "additionalProperties": false
    },
