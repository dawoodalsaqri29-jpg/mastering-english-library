          "mood": "night",
          "character": "sam",
          "shot": "mid",
          "expression": "shock",
          "sfx": "SPLASH!",
          "sfxColor": "ice",
          "effect": "speed"
        }
      ],
      "layout": "feature",
      "camera": "follow"
    },
    "exampleNarration": "Water evaporates from the warm ocean, rises and cools into clouds. It condenses around tiny specks of dust, until the drops get too heavy and fall."
