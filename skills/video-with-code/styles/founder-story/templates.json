[
  {
    "id": "founder-intro",
    "name": "Founder Intro",
    "description": "THE WORKHORSE. A big-headed caricature of a generic business archetype stands in the foreground over the aerial empire; the company headline plate (name + year band) slides in top-right; a bold caps headline pops on its key word; an optional stat counts up. Buildings can grow during the scene. Use for hooks, chapter intros, most talking scenes.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "company": { "type": "string", "description": "Company name shown on the plate in bold caps (1-3 words). Plain type only, never a logo." },
        "years": { "type": "string", "description": "Year band under the name, e.g. \"1937 – 2026\" or \"EST. 1976\"." },
        "kicker": { "type": "string", "description": "Optional tiny caps line above the company name (1-4 words), e.g. \"THE ENTIRE HISTORY OF\"." },
        "archetype": { "type": "string", "enum": ["founder", "engineer", "inventor", "retailer", "techie", "investor", "executive"], "description": "Generic caricature archetype. Keep the same one for the same company across the video." },
        "empire": { "type": "string", "enum": ["tech", "factory", "auto", "retail", "shipping", "finance", "energy", "food", "garage", "city"], "description": "Aerial landscape behind the figure. Keep it consistent for a company; use garage for early days." },
        "growth": { "type": "string", "enum": ["small", "growing", "full"], "description": "How much of the empire exists at the start; anything missing pops up during the scene." },
        "sky": { "type": "string", "enum": ["day", "dawn", "sunset", "storm", "night"], "description": "Sky mood." },
        "headline": { "type": "string", "description": "Bold caps headline (2-7 words). Wrap one word in *asterisks* to colour it red." },
        "keyword": { "type": "string", "description": "Narration word on which the headline pops (must appear in the narration; defaults to the most distinctive headline word)." },
        "stat": { "type": "object", "properties": { "value": { "type": "string", "description": "Number with prefix/suffix, e.g. \"$3.2B\", \"47%\", \"12000\" (counts up)." }, "label": { "type": "string", "description": "What the number is (2-6 words)." }, "word": { "type": "string", "description": "Narration word on which the stat appears." } }, "required": ["value", "label"], "additionalProperties": false },
        "expression": { "type": "string", "enum": ["neutral", "confident", "happy", "excited", "worried", "shocked", "angry", "determined", "smug", "sad", "thinking", "laughing", "skeptical", "tired"], "description": "Base expression." },
        "pose": { "type": "string", "enum": ["idle", "arms-crossed", "talk", "explain", "point", "point-up", "blueprint", "tablet", "phone", "thumbs-up", "hands-hips", "present", "briefcase", "coffee", "think"], "description": "Resting pose (default arms-crossed)." },
        "side": { "type": "string", "enum": ["left", "right"], "description": "Side the figure stands on (landscape)." },
        "beats": { "type": "array", "description": "Up to 3 acting beats on narration words.", "items": { "type": "object", "properties": { "word": { "type": "string" }, "pose": { "type": "string", "enum": ["talk", "explain", "point", "point-up", "point-viewer", "blueprint", "tablet", "phone", "thumbs-up", "hands-hips", "worried", "present", "open-arms", "wave", "facepalm", "shrug", "fist-pump", "think", "celebrate", "money", "megaphone"] }, "expression": { "type": "string", "enum": ["neutral", "confident", "happy", "excited", "worried", "shocked", "angry", "determined", "smug", "sad", "thinking", "laughing", "skeptical", "tired"] }, "mark": { "type": "string", "enum": ["sweat", "exclaim", "question", "idea", "dollar", "anger", "sparkle", "zzz", "check", "cross"] } }, "required": ["word"], "additionalProperties": false } }
      },
      "required": ["company", "headline"],
      "additionalProperties": false
    },
    "exampleProps": { "company": "Northwind Motors", "years": "1937 – 2026", "kicker": "THE ENTIRE HISTORY OF", "archetype": "founder", "empire": "auto", "growth": "growing", "headline": "From one garage to *forty* factories", "keyword": "forty", "stat": { "value": "$48B", "label": "annual revenue today", "word": "billion" }, "beats": [{ "word": "nobody", "pose": "shrug", "expression": "skeptical" }] },
    "exampleNarration": "This is the entire history of Northwind Motors. From one garage to forty factories, and forty eight billion dollars in annual revenue. And nobody believed it would work."
  },
