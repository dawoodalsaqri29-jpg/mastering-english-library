  {
    "id": "cosmic-zoom",
    "name": "Cosmic Zoom",
    "description": "Continuous camera dive through 2–6 nested scales (e.g. galaxy → sun → earth → city → cell). Each next world opens as a liquid portal inside the previous one while the camera keeps zooming; each level's label lands on its key word. The signature 'zoom through scales' shot.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Optional title shown before the dive"
        },
        "levels": {
          "type": "array",
          "description": "2–6 levels, outermost first. Each level's label should be spoken in the narration in this order.",
          "items": {
            "type": "object",
