      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "title": "How *Volcanoes* Work",
      "subtitle": "From magma to mountains",
      "kicker": "Chapter 1",
      "setting": "meadow",
      "creature": "pip",
      "hero": "house"
    },
    "exampleNarration": "How volcanoes work. Let us go from deep magma all the way up to brand new mountains."
