  {
    "id": "micro-world",
    "name": "Micro World",
    "description": "Microscopic world in liquid: 1–4 living subjects (cells, bacteria, viruses, DNA, molecules, atoms, neurons) wobble and float with labels, a swarm drifts behind, and an optional event makes one subject move into another with a burst (attack, bond, infect, divide).",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Optional title"
        },
        "subjects": {
          "type": "array",
          "description": "1–4 subjects",
          "items": {
            "type": "object",
            "properties": {
              "illus": {
                "type": "string",
                "description": "Microscopic subject",
                "enum": [
                  "cell",
                  "bacteria",
                  "virus",
                  "dna",
                  "molecule",
                  "atom",
                  "neuron",
                  "heart",
                  "brain",
                  "drop",
                  "pill"
                ]
              },
              "label": {
                "type": "string",
                "description": "Short label, spoken in narration"
              }
            },
            "required": [
              "illus",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "event": {
          "type": "object",
          "properties": {
            "from": {
              "type": "number",
              "description": "Index of the subject that moves (0-based)"
            },
            "to": {
              "type": "number",
              "description": "Index of the subject it reaches"
            },
            "verb": {
              "type": "string",
              "description": "Short action word/phrase spoken in narration, e.g. 'attacks'"
            }
          },
          "required": [
            "from",
            "to",
            "verb"
          ],
          "additionalProperties": false
        },
        "world": {
          "type": "string",
          "description": "Backdrop",
          "enum": [
            "micro",
            "body",
            "ocean"
          ]
        },
        "faces": {
          "type": "boolean",
          "description": "Give bacteria/viruses cute faces"
        }
      },
      "required": [
        "subjects"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "title": "Inside your *blood*",
      "subjects": [
        {
          "illus": "virus",
          "label": "Virus"
        },
        {
          "illus": "cell",
          "label": "White blood cell"
        }
      ],
      "event": {
        "from": 1,
        "to": 0,
        "verb": "swallows it"
      },
      "world": "body"
    },
    "exampleNarration": "A virus slips into your blood. But a white blood cell spots it, races over, and swallows it whole."
  },
