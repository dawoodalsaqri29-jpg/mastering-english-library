[
  {
    "id": "title-landscape",
    "name": "Title Landscape",
    "description": "Opening/section title over a big illustrated parallax world (rolling hills, dusk mountains, night city, space, ocean or micro-world) with a mascot that drops in and waves and a hero illustration. Use for video intros and chapter openers.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Main title, 2–7 words. Wrap one word in *asterisks* to colour it yellow."
        },
        "subtitle": {
          "type": "string",
          "description": "Optional short subtitle (≤ 10 words)"
        },
        "kicker": {
          "type": "string",
          "description": "Optional tiny label above the title, e.g. 'Chapter 2'"
        },
        "setting": {
          "type": "string",
          "description": "Illustrated world",
          "enum": [
            "meadow",
            "dusk",
            "night",
            "space",
            "ocean",
            "micro"
          ]
        },
        "creature": {
          "type": "string",
          "description": "Mascot from the recurring cast",
          "enum": [
            "pip",
            "nova",
            "momo",
            "zib"
          ]
        },
        "hero": {
          "type": "string",
          "description": "Hero illustration standing in the world (house, tree, rocket, saturn…)",
          "enum": [
            "planet",
            "saturn",
            "gasgiant",
            "mars",
            "earth",
            "moon",
            "sun",
            "star",
            "galaxy",
            "blackhole",
            "rocket",
            "satellite",
            "cell",
            "bacteria",
            "virus",
            "dna",
            "molecule",
            "atom",
            "neuron",
            "body",
            "brain",
            "heart",
            "pill",
            "tree",
            "sprout",
            "flower",
            "fish",
            "wave",
            "drop",
            "cloud",
            "mountain",
            "city",
            "house",
            "people",
            "factory",
            "coin",
            "cash",
            "gear",
            "clock",
            "blast",
            "bolt",
            "flame",
            "bulb",
            "book",
            "laptop",
            "chip",
            "magnet",
            "trophy"
          ]
        }
