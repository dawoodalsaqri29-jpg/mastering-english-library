[
  {
    "id": "character-speaks",
    "name": "Character Speaks",
    "description": "The workhorse: one cast member talks to camera with lip-sync, blinks and hair sway on a painted location, then the camera snaps to a close-up for the second half. An optional slanted key-text callout pops on its key word while the character gestures; anime subtitles run underneath.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "character": {
          "type": "string",
          "enum": [
            "hikari",
            "ren",
            "kaito",
            "yuki",
            "mochi"
          ],
          "description": "Cast member — keep the same cast for the same roles across the whole video (hikari = hero, ren = mentor, kaito = rival/friend, yuki = classmate, mochi = mascot)."
        },
        "location": {
          "type": "string",
          "enum": [
            "rooftop",
            "sunset-city",
            "classroom",
            "train",
            "night-city",
            "shrine",
            "space",
            "sky",
            "meadow"
          ],
          "description": "Location. Keep it consistent between neighbouring scenes."
        },
        "text": {
          "type": "string",
          "description": "Optional key text callout (2–8 words). Wrap one word in *asterisks* to highlight it."
        },
        "kicker": {
          "type": "string",
          "description": "Optional tiny tag above the callout (1–3 words)."
        },
        "keyword": {
          "type": "string",
          "description": "Narration word on which the callout pops and the key gesture lands."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon name for the callout (e.g. lightbulb, rocket, brain, star, heart, target, bolt, book, clock, trophy)."
        },
        "expression": {
          "type": "string",
          "enum": [
            "neutral",
            "smile",
            "happy",
            "excited",
            "sparkle",
            "shocked",
            "surprised",
            "determined",
            "serious",
            "sweat-drop",
            "panic",
            "flustered",
            "sad",
            "angry",
            "smug",
            "calm",
            "thinking",
            "embarrassed",
            "sleepy"
          ],
          "description": "Base expression (default: the character's usual look)."
        },
        "keyExpression": {
          "type": "string",
          "enum": [
            "neutral",
            "smile",
            "happy",
            "excited",
            "sparkle",
            "shocked",
            "surprised",
            "determined",
            "serious",
            "sweat-drop",
            "panic",
            "flustered",
            "sad",
            "angry",
            "smug",
            "calm",
            "thinking",
            "embarrassed",
            "sleepy"
          ],
          "description": "Expression from the keyword on."
        },
        "closeExpression": {
          "type": "string",
          "enum": [
            "neutral",
            "smile",
            "happy",
            "excited",
            "sparkle",
            "shocked",
            "surprised",
            "determined",
            "serious",
            "sweat-drop",
            "panic",
            "flustered",
            "sad",
            "angry",
            "smug",
            "calm",
            "thinking",
            "embarrassed",
            "sleepy"
          ],
          "description": "Expression in the close-up half."
        },
        "gesture": {
          "type": "string",
          "enum": [
            "rest",
            "fist",
            "fist-up",
            "point",
            "point-left",
            "point-up",
            "think",
            "wave",
            "peace",
            "thumbs",
            "cheer",
            "panic",
            "glasses",
            "explain",
            "present",
            "cross",
            "clasp",
            "ready",
            "punch"
          ],
          "description": "Gesture on the keyword (default: the character's signature move)."
        },
        "side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "description": "Which side the character stands on in landscape (text goes on the other side)."
        },
        "closeUp": {
          "type": "boolean",
          "description": "Cut to a close-up for the second half (default true)."
        },
        "subtitles": {
          "type": "boolean",
          "description": "Show anime subtitles of the narration (default true)."
        },
        "beats": {
          "type": "array",
          "description": "Optional acting beats (1–3) landing on narration words.",
          "items": {
            "type": "object",
            "properties": {
              "word": {
                "type": "string",
                "description": "Narration word the beat lands on (must appear in the narration)."
              },
              "expression": {
                "type": "string",
                "enum": [
                  "neutral",
                  "smile",
                  "happy",
                  "excited",
                  "sparkle",
