                  "ready",
                  "punch"
                ],
                "description": "Gesture from this word on."
              }
            },
            "required": [
              "word"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "character"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "character": "hikari",
      "location": "rooftop",
      "text": "Small steps beat *big* leaps",
      "kicker": "Rule #1",
      "keyword": "steps",
      "icon": "rocket",
      "keyExpression": "determined",
      "beats": [
        {
          "word": "every",
          "expression": "excited"
        }
      ]
    },
    "exampleNarration": "Here is the secret nobody tells you. Small steps, taken every single day, beat one giant leap you never finish."
  },
  {
    "id": "dialogue",
    "name": "Dialogue (Shot / Reverse Shot)",
    "description": "Two characters talk: an establishing two-shot, then quick cuts between single shots of whoever is speaking (with whip-pan streaks), name plates and anime subtitles. Each line lip-syncs to its words in the narration; listeners react.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "description": "Exactly two cast members [left, right].",
          "items": {
            "type": "string",
            "enum": [
              "hikari",
              "ren",
              "kaito",
              "yuki",
              "mochi"
            ],
            "description": "Cast member."
          }
        },
        "location": {
          "type": "string",
          "enum": [
            "rooftop",
