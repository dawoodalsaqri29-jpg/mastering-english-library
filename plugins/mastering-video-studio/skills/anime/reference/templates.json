  {
    "id": "eyecatch-title",
    "name": "Eyecatch Title",
    "description": "Episode or chapter opener: a stripe wipe, a rotating sunburst on a slanted pink band, a bouncing chibi mascot and a huge slanted title that slams in with an episode tag and subtitle.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "episode": {
          "type": "string",
          "description": "Small tag above the title, e.g. \"Episode 3\" or \"Chapter 2\"."
        },
        "title": {
          "type": "string",
          "description": "Episode title (2–6 words)."
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle line (≤ 8 words)."
        },
        "character": {
          "type": "string",
          "enum": [
            "hikari",
            "ren",
            "kaito",
            "yuki",
            "mochi"
          ],
          "description": "Chibi on the card (default mochi)."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "episode": "Episode 4",
      "title": "The *Budget* Strikes Back",
      "subtitle": "How to save without suffering",
