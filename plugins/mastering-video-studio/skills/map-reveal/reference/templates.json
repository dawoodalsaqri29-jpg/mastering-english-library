              "stat": {
                "type": "number",
                "description": "Optional number for a badge pinned to the marker."
              },
              "statSuffix": {
                "type": "string",
                "description": "Badge suffix, e.g. ' KM' or ' M'."
              },
              "statPrefix": {
                "type": "string",
                "description": "Badge prefix."
              },
              "statCaption": {
                "type": "string",
                "description": "Badge caption, up to 3 words."
