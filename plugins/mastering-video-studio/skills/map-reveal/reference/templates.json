[
  {
    "id": "map-focus",
    "name": "Map focus (workhorse)",
    "description": "The workhorse: the satellite relief map of a region, a glowing zone and pulsing red target ring on one place, a bold red arrow sweeping in from the edge, an outlined label, and a huge thumbnail headline that lands on the key word while the camera pushes toward the place. Use for most scenes: 'this region', 'right here', 'in this corner of the country'.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "enum": [
            "world",
            "australia",
            "usa",
            "europe",
            "africa",
            "south-america",
            "india",
            "china",
            "japan",
            "uk",
            "egypt-nile",
            "middle-east",
            "antarctica",
            "mediterranean",
            "island",
            "archipelago",
            "continent",
            "peninsula"
          ],
          "description": "Map to show. Real regions have named anchors (see SKILL.md); island / archipelago / continent / peninsula are generic landmasses with anchors like center, north, capital, coast, bay, peak."
        },
        "place": {
          "type": "string",
          "description": "Where the action is: an anchor name of the region (e.g. 'pilbara', 'cairo', 'texas') or 'lon,lat' (e.g. '131,-25') or normalised 'x,y' in 0..1 for generic landmasses."
        },
        "headline": {
          "type": "string",
          "description": "Thumbnail-style headline, 2-7 words, caps look best. Wrap one or two words in *stars* to colour them yellow, e.g. 'HIDDEN FOR *1 BILLION* YEARS'."
        },
        "keyword": {
          "type": "string",
          "description": "One word copied from the narration; the headline and label land on it."
        },
        "label": {
          "type": "string",
          "description": "Short boxed label on the place, 1-4 words (a name)."
        },
        "sub": {
          "type": "string",
          "description": "Small line under the label, up to 5 words (e.g. a year, 'POPULATION 2 MILLION')."
        },
        "kicker": {
          "type": "string",
          "description": "Small red tag at top-left, up to 4 words, e.g. 'FACT #3' or 'WESTERN AUSTRALIA'."
        },
        "color": {
          "type": "string",
          "enum": [
            "red",
            "yellow",
            "cyan",
            "green",
            "orange",
            "white"
          ],
          "description": "Zone / ring / arrow colour (red default)."
        },
        "lava": {
          "type": "boolean",
          "description": "Make the zone a hot glowing lava / heat spot (orange-yellow core)."
        },
        "zoneRadius": {
          "type": "number",
          "description": "Glow size as a fraction of the map, 0.03-0.3 (default 0.1)."
        },
        "arrowFrom": {
          "type": "string",
          "enum": [
            "auto",
            "left",
            "right",
            "top",
            "bottom"
          ],
          "description": "Edge the arrow sweeps in from (auto picks the far side)."
        },
        "zoom": {
          "type": "number",
          "description": "How far the camera pushes toward the place, 1 (none) to 4 (default 1.7)."
        },
        "stat": {
          "type": "number",
          "description": "Optional number for a corner stat card (counts up)."
        },
        "statPrefix": {
          "type": "string",
          "description": "Prefix for the stat, e.g. '$'."
        },
        "statSuffix": {
          "type": "string",
          "description": "Suffix for the stat, e.g. ' KM', ' BILLION', '%'."
        },
        "statCaption": {
          "type": "string",
          "description": "Caption under the stat, up to 4 words."
        }
      },
      "required": [
        "region",
        "place",
        "headline",
        "keyword"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "region": "australia",
      "place": "pilbara",
      "headline": "HIDDEN FOR *3 BILLION* YEARS",
      "keyword": "ancient",
      "label": "The Pilbara",
      "sub": "WESTERN AUSTRALIA",
      "kicker": "FACT #1",
      "color": "red",
      "stat": 3.6,
      "statSuffix": " BN YEARS",
      "statCaption": "oldest rocks on Earth"
    },
    "exampleNarration": "In the far north-west of Australia lies a region called the Pilbara, where some of the most ancient rocks on the planet have been hiding for over three billion years."
  },
  {
    "id": "hidden-discovery",
    "name": "Hidden discovery (underground reveal)",
    "description": "Zooms from the whole region into a glowing site, then an underground cross-section panel unfolds: layered strata, a scanning line, a drill line and the glowing deposit (gold, oil, water, lava, crystal, gas, diamond, fossil, cave...). For 'scientists just found', 'buried beneath', 'deposit discovered' moments.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "enum": [
            "world",
            "australia",
            "usa",
            "europe",
            "africa",
            "south-america",
            "india",
            "china",
            "japan",
            "uk",
            "egypt-nile",
