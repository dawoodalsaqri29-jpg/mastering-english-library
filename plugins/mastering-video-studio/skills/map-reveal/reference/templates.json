          "description": "Depth text printed at the bottom of the panel, e.g. '2 KM' or '600 M'."
        },
        "panelTitle": {
          "type": "string",
          "description": "Tag on the panel, up to 3 words (default 'CROSS-SECTION')."
        },
        "kicker": {
          "type": "string",
          "description": "Small red tag, up to 4 words."
        },
        "stat": {
          "type": "number",
          "description": "Optional number for a stat card after the reveal."
        },
        "statPrefix": {
          "type": "string",
          "description": "Stat prefix."
        },
        "statSuffix": {
          "type": "string",
          "description": "Stat suffix."
        },
        "statCaption": {
          "type": "string",
          "description": "Stat caption, up to 4 words."
        }
      },
      "required": [
        "region",
        "site",
        "kind",
        "headline",
        "keyword"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "region": "australia",
      "site": "pilbara",
      "kind": "iron",
      "headline": "WHAT THEY FOUND *UNDERNEATH*",
      "keyword": "beneath",
      "revealKeyword": "ore",
      "label": "Hamersley Range",
      "discoveryLabel": "55 BILLION TONS",
      "depth": "1 KM",
      "kicker": "DISCOVERY",
      "stat": 55,
      "statSuffix": " BN TONS",
      "statCaption": "iron ore reserve"
    },
    "exampleNarration": "Beneath the red dust of the Hamersley Range, geologists mapped a single body of iron ore so vast that it could supply the entire world for a century."
  },
  {
    "id": "fact-countdown",
    "name": "Fact countdown (numbered markers)",
    "description": "A numbered marker pops onto the map for each fact (counting down 5-4-3... or up), each with a boxed label and optional stat badge, while the camera hops from place to place. For listicles: '10 insane facts', 'top 5 places'.",
