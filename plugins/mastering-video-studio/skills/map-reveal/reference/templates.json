            "lithium",
            "copper",
            "uranium",
            "coal",
            "salt",
            "aquifer",
            "magma"
          ],
          "description": "What is buried; sets the deposit colour and look."
        },
        "headline": {
          "type": "string",
          "description": "Headline, 2-7 words, shown while zooming in (e.g. 'WHAT THEY FOUND UNDERNEATH')."
        },
        "keyword": {
          "type": "string",
          "description": "Narration word the zoom-in and headline land on."
        },
        "revealKeyword": {
          "type": "string",
          "description": "Narration word on which the cross-section panel unfolds (after keyword)."
        },
        "label": {
          "type": "string",
          "description": "Boxed label on the site, 1-4 words."
