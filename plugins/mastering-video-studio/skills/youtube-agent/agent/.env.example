# Mastering English Library: YouTube Agent. Everything works with NO keys (free Kokoro voice,
# frame thumbnails, web-search fact check, Buffer / manual upload). The keys below only add paid
# extras. If you want one, copy this file to .env and fill in YOUR OWN keys.
# They stay on your computer. Each tool sends a key only to the service it belongs to.
# Claude Code itself runs on your own Claude subscription: no Anthropic key needed here.

# Voice: ElevenLabs (elevenlabs.io > Developers > API keys). Leave empty if you record your own voice.
ELEVENLABS_API_KEY=
# Optional: a voice from your ElevenLabs library, and the model (eleven_multilingual_v2 or eleven_v4).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Thumbnails with GPT Image 2.5, and word timing when you use your own recording
# (platform.openai.com > API keys).
OPENAI_API_KEY=
# gpt-image-2.5-sunburst (default) or gpt-image-2.5-flare (cheaper)
OPENAI_IMAGE_MODEL=

# Posting to YouTube through Zernio (zernio.com > connect your YouTube channel > API keys).
ZERNIO_API_KEY=
# Only if you connected more than one YouTube channel: node tools/post-youtube.mjs --accounts
ZERNIO_YOUTUBE_ACCOUNT_ID=

# Optional extras
# Stock footage (free): pexels.com/api and pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Fact check (perplexity.ai > Settings > API)
PERPLEXITY_API_KEY=
# Topic finder (Google Cloud console > YouTube Data API v3 > Credentials)
YOUTUBE_API_KEY=

# Free voice model folder (kokoro-v1.0.onnx + voices-v1.0.bin). Default: ~/tts
KOKORO_DIR=
