  {
    "id": "paper-list",
    "name": "Corkboard list",
    "description": "Torn-off sticky notes are pinned one by one to a corkboard (push pins pop in), with a cut-paper title strip. For lists, steps, tips (2-6 items).",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Board title (max 6 words)."
        },
        "board": {
          "type": "string",
          "enum": [
            "cork",
            "felt",
            "kraft"
          ],
          "description": "Board material."
        },
        "items": {
          "type": "array",
          "description": "2-6 notes in narration order.",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "Note text, max 10 words. *word* = red emphasis."
              },
              "keyword": {
                "type": "string",
                "description": "Word from the narration when it is pinned (optional)."
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "title": "Three habits that stick",
      "board": "cork",
      "items": [
        {
          "text": "Start *tiny* — two minutes a day",
          "keyword": "tiny"
        },
        {
          "text": "Stack it on an existing habit",
          "keyword": "stack"
        },
        {
          "text": "Track your streak on paper",
          "keyword": "track"
        }
      ]
    },
    "exampleNarration": "Three habits that stick. Start tiny. Stack the new habit on an old one. And track your streak."
  },
  {
    "id": "cut-out-chart",
    "name": "Cut-out bar chart",
    "description": "Bars built from paper strips that drop and stack one by one on a ruler, on taped graph paper; value tags stamp on top. For comparing 2-6 numbers.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Chart title (max 7 words)."
        },
        "bars": {
          "type": "array",
          "description": "2-6 bars.",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Bar label, 1-3 words."
              },
              "value": {
                "type": "number",
                "description": "Value (>= 0)."
              },
              "keyword": {
                "type": "string",
                "description": "Word when this bar builds (optional)."
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "prefix": {
          "type": "string",
          "description": "Value prefix, e.g. \"$\" (or empty)."
        },
        "suffix": {
          "type": "string",
          "description": "Value suffix, e.g. \"%\" (or empty)."
        },
        "highlight": {
          "type": "number",
          "description": "Index of the bar to colour red (optional)."
        }
      },
      "required": [
        "title",
        "bars"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "title": "Hours of screen time a day",
