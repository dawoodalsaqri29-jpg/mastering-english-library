[
  {
    "id": "puppet-talks",
    "name": "Puppet talks",
    "description": "A paper puppet hops onto a diorama set and talks (mouth synced to the voice); the speech-bubble words land as they are spoken; an optional second puppet listens and reacts; optional stencil tags pop in on key words. The default storytelling shot.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "set": {
          "type": "string",
          "enum": [
            "town",
            "countryside",
            "kitchen",
            "classroom",
            "ocean",
            "underwater",
            "space"
          ],
          "description": "Diorama set (location). Keep the same set for scenes in the same place."
        },
        "speaker": {
          "type": "string",
          "enum": [
            "mo",
            "pip",
            "otto",
            "ada",
            "leo",
            "biscuit",
            "mittens",
            "hoot"
          ],
          "description": "Recurring puppet: mo (kid, orange hoodie), pip (girl, yellow dress), otto (grandpa), ada (scientist), leo (chef), biscuit (dog), mittens (cat), hoot (owl)."
        },
        "listener": {
          "type": "string",
          "enum": [
            "mo",
            "pip",
            "otto",
            "ada",
            "leo",
            "biscuit",
            "mittens",
            "hoot",
            "none"
          ],
          "description": "Optional puppet, or \"none\"."
        },
        "bubble": {
          "type": "string",
          "description": "What the speaker says in the bubble — a short line from the narration, max 14 words. *word* = red emphasis strip."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "0-3 short labels (1-3 words) that pop in on their key words."
        },
        "title": {
          "type": "string",
          "description": "Optional headline at the top (max 6 words); usually leave empty."
        }
      },
      "required": [
        "set",
        "speaker",
        "listener",
        "bubble"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "set": "town",
      "speaker": "pip",
      "listener": "otto",
      "bubble": "Did you know our town *recycles* half its rubbish?",
      "tags": [
        "Paper",
        "Glass",
        "Cans"
      ]
    },
    "exampleNarration": "Did you know our town recycles half its rubbish? Paper, glass and cans all get a second life."
  },
  {
    "id": "diorama-scene",
