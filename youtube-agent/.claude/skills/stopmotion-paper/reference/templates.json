            "ocean",
            "underwater",
            "space"
          ],
          "description": "Diorama set (location). Keep the same set for scenes in the same place."
        },
        "title": {
          "type": "string",
          "description": "Optional headline (max 6 words), or empty string."
        },
        "character": {
          "type": "string",
          "enum": [
