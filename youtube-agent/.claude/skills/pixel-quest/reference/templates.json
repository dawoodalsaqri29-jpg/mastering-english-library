[
  {
    "id": "title-screen",
    "name": "Title Screen",
    "description": "Game boot screen: a big bouncing pixel logo, a subtitle ribbon, the hero and companion marching through a scrolling world, and a blinking PRESS START that gets 'pressed' on its key word (flash + jump). Use to open the video or a big new part.",
    "propsSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Game title, 1–5 words (rendered in caps)."
        },
        "subtitle": {
          "type": "string",
          "description": "Optional tagline, under 40 characters."
        },
        "world": {
          "type": "string",
          "enum": [
            "grassland",
            "cave",
            "city",
            "castle",
            "space",
            "underwater"
          ],
          "description": "Background world."
        },
        "prompt": {
          "type": "string",
          "description": "Blinking prompt, default 'PRESS START'. Its last word is synced to the narration."
        },
        "hero": {
          "type": "string",
          "enum": [
            "kit",
            "orla",
            "bolt",
            "vex",
            "mo"
          ],
          "description": "Main character (default kit)."
        },
        "companion": {
          "type": "string",
          "enum": [
            "kit",
            "orla",
            "bolt",
            "vex",
            "mo"
          ],
          "description": "Sidekick walking behind (default bolt)."
        },
        "footer": {
          "type": "string",
          "description": "Optional tiny footer line."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "exampleProps": {
      "title": "The Quest for Sleep",
      "subtitle": "A science adventure",
      "world": "grassland",
      "prompt": "PRESS START"
    },
    "exampleNarration": "Welcome to the quest for better sleep. Grab your controller and press start."
  },
  {
    "id": "level-walk",
    "name": "Level Walk",
